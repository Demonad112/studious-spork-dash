{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-console.invalid/schemas/pairing.schema.json",
  "title": "Remote console HTTP pairing bodies, protocol version 1",
  "oneOf": [
    {
      "$ref": "#/$defs/pairStartRequest"
    },
    {
      "$ref": "#/$defs/pairStartResponse"
    },
    {
      "$ref": "#/$defs/pairStatusRequest"
    },
    {
      "$ref": "#/$defs/pairStatusResponse"
    },
    {
      "$ref": "#/$defs/pairLookupRequest"
    },
    {
      "$ref": "#/$defs/pairLookupResponse"
    },
    {
      "$ref": "#/$defs/pairApproveRequest"
    }
  ],
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "b64u32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "b64u64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "pairingCode": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^([0-9a-f]{4}-){3}[0-9a-f]{4}$"
    },
    "pairStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-start"
        },
        "installId": {
          "$ref": "#/$defs/hex32"
        },
        "publicKey": {
          "$ref": "#/$defs/b64u32"
        }
      },
      "required": ["kind", "installId", "publicKey"]
    },
    "pairStartResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-start-result"
        },
        "pairingCode": {
          "$ref": "#/$defs/pairingCode"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "expiresInSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": ["kind", "pairingCode", "fingerprint", "expiresInSec"]
    },
    "pairStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-status"
        },
        "installId": {
          "$ref": "#/$defs/hex32"
        },
        "timestampMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "signature": {
          "$ref": "#/$defs/b64u64"
        }
      },
      "required": ["kind", "installId", "timestampMs", "signature"]
    },
    "pairStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-status-result"
        },
        "status": {
          "enum": ["pending", "approved", "expired", "rejected"]
        }
      },
      "required": ["kind", "status"]
    },
    "pairApproveRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-approve"
        },
        "pairingCode": {
          "$ref": "#/$defs/pairingCode"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "approve": {
          "type": "boolean"
        }
      },
      "required": ["kind", "pairingCode", "displayName", "approve"]
    },
    "pairLookupRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-lookup"
        },
        "pairingCode": {
          "$ref": "#/$defs/pairingCode"
        }
      },
      "required": ["kind", "pairingCode"]
    },
    "pairLookupResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pair-lookup-result"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "rekey": {
          "type": "boolean"
        }
      },
      "required": ["kind", "fingerprint", "rekey"]
    }
  }
}
