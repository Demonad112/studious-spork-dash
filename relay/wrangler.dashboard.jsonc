{
  "name": "remote-console-dashboard",
  "main": "src/dashboard-worker.ts",
  "compatibility_date": "2026-04-07",
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO", "script_name": "remote-console-relay" },
      { "name": "SESSION", "class_name": "SessionDO", "script_name": "remote-console-relay" },
    ],
  },
  // The SPA build. run_worker_first sends every request through the Worker, which verifies the
  // Access JWT before it hands anything to the assets binding. Deep links fall back to index.html.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
  },
  "observability": { "enabled": true },
}
